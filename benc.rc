/*
 * benc.rc - Windows resource script.
 *
 * Embeds the application icon (img/benc.ico) and a VERSIONINFO block into
 * benc.exe.  windres compiles this to a COFF object that is linked into the
 * Windows executables by the windows-* Makefile targets.
 *
 * Keep the FILEVERSION / PRODUCTVERSION numbers in sync with BENC_VERSION in
 * benc.c (currently 1.4.1).
 */

#include <windows.h>
#include <winver.h>

/* Application icon: Explorer, taskbar, Alt-Tab and the file Properties
 * dialog all read this.  img/benc.ico is a multi-size 32-bit icon set. */
1 ICON "img/benc.ico"

1 VERSIONINFO
FILEVERSION    1,4,1,0
PRODUCTVERSION 1,4,1,0
FILEFLAGSMASK  0x3fL
FILEFLAGS      0x0L
FILEOS         VOS_NT_WINDOWS32
FILETYPE       VFT_APP
FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "ArdeshirV"
            VALUE "FileDescription",  "benc - portable password based file encryption"
            VALUE "FileVersion",      "1.4.1"
            VALUE "InternalName",     "benc"
            VALUE "LegalCopyright",   "ArdeshirV, see LICENSE"
            VALUE "OriginalFilename", "benc.exe"
            VALUE "ProductName",      "benc"
            VALUE "ProductVersion",   "1.4.1"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
